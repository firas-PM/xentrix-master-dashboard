# MongoDB Atlas connection string
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xentrix_dashboard?retryWrites=true&w=majority
MONGODB_URI=

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Cron endpoint bearer (used by Vercel Cron to trigger recurring task materialization)
CRON_SECRET=

# Optional: enables the "Email me a login link" magic-link flow.
# Get a key at https://resend.com/api-keys — free tier is 100 emails/day.
# EMAIL_FROM must be a verified sender on your Resend account.
RESEND_API_KEY=
EMAIL_FROM=Xentrix <no-reply@xentrix.xyz>
